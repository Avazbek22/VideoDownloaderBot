[Unit]
Description=Rebuild __APP_SLUG__ with fresh dependencies
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=__INSTALL_DIR__
Environment="ROOT_DIR=__INSTALL_DIR__"
Environment=APP_SLUG=__APP_SLUG__
ExecStart=/usr/bin/env bash "__INSTALL_DIR__/scripts/deploy.sh" --rebuild
TimeoutStartSec=90min
